set listOfScenaris = [
    ["Rock" , "Paper", "Player 2 Won"],
    ["Rock" , "Scissors", "Player 1 Won"],
    ["Paper" , "Rock", "Player 1 Won"],
    ["Paper" , "Scissors", "Player 2 Won"],
    ["Scissors" , "Rock", "Player 2 Won"],
    ["Scissors" , "Paper", "Player 1 Won"],
    ["Scissors" , "Scissors", "Draw"],
    ["Rock" , "Rock", "Draw"],
    ["Paper" , "Paper", "Draw"]
]

set Moves = ["Rock", "Paper", "Scissors"]

do PlayersChoice(PlayersName: text): text
    repeat forever
        set Choice = ask PlayersName + ", choose Rock, Paper or Scissors: "
        repeat each Move in Moves
            if Move == Choice
                return Choice
            end
        end
        say "Not a valid move."
    end
end

do BotsChoice(): text
    return Moves[random(1, 3)]
end

do CheckWinner(Input1: text, Input2: text): text
    repeat each Row in listOfScenaris
        if Row[1] == Input1 and Row[2] == Input2
            return Row[3]
        end
    end
    return "Draw"
end
    
repeat forever 
   

    set Multiplayer = ask "Do you want to play 1v1 or against a bot? (1/2): "

    if Multiplayer == "1" or Multiplayer == "2"
        set Input1: text = PlayersChoice("Player 1")
        set Input2 = ""
        set Bot = false

        if Multiplayer == "1" 
            set Input2: text = PlayersChoice("Player 2")
        otherwise if Multiplayer == "2"
            set Input2: text = BotsChoice() 
            say "Bot chose: " + Input2
            set Bot = true
        end
        
        set Result = CheckWinner(Input1, Input2)

        if Bot == true and Result == "Player 2 Won"
            say "The bot won, your so bad"
        otherwise
            say "The result is: " + Result
        end
        

    otherwise 
        say "Invalid input. Please enter 1 or 2."
        skip
    end


    set Again = ask "Do you want to play again? (y/n): "

    if Again == "n" 
        stop
    end

end